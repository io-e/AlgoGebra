diff --git a/03-RCP-Spike/build.sh b/03-RCP-Spike/build.sh
index 1d1fc89..e8d2a77 100755
--- a/03-RCP-Spike/build.sh
+++ b/03-RCP-Spike/build.sh
@@ -36,6 +36,24 @@ mkdir -p "$T/host"; "$JAVAC" -encoding UTF-8 --release 21 -cp "$CP" -d "$T/host"
 "$JAR" cfm "$OUT/org.geogebra.plus.host_0.1.0.jar" "$ROOT/host/META-INF/MANIFEST.MF" -C "$T/host" . -C "$ROOT/host" plugin.xml
 "$JAR" cfm "$OUT/org.geogebra.plus.desktop.resources_0.1.0.jar" "$ROOT/host/resources/META-INF/MANIFEST.MF" \
   -C "$GGB_SRC/desktop/desktop/src/main/resources" . -C "$GGB_SRC/shared/common/src/main/resources" .
+# ReTeX looks up fonts through FactoryProviderDesktop's defining classloader.
+# Keep the upstream renderer bundle intact and contribute its resources using
+# a product-local fragment attached to that exact OSGi bundle.
+RENDERER_RESOURCE_ROOT="$GGB_SRC/desktop/renderer-desktop/src/main/resources"
+RENDERER_FONT_PATH="com/himamis/retex/renderer/desktop/fonts"
+for font in \
+  "$RENDERER_FONT_PATH/latin/jlm_cmr10.ttf" \
+  "$RENDERER_FONT_PATH/latin/optional/jlm_cmssbx10.ttf"; do
+  [ -f "$RENDERER_RESOURCE_ROOT/$font" ] || { echo "Missing required ReTeX font resource: $RENDERER_RESOURCE_ROOT/$font"; exit 1; }
+done
+RENDERER_RESOURCES="$OUT/org.geogebra.plus.renderer.resources_0.1.0.jar"
+"$JAR" cfm "$RENDERER_RESOURCES" "$ROOT/host/renderer-resources/META-INF/MANIFEST.MF" \
+  -C "$RENDERER_RESOURCE_ROOT" "$RENDERER_FONT_PATH"
+for font in \
+  "$RENDERER_FONT_PATH/latin/jlm_cmr10.ttf" \
+  "$RENDERER_FONT_PATH/latin/optional/jlm_cmssbx10.ttf"; do
+  "$JAR" tf "$RENDERER_RESOURCES" | grep -Fqx "$font" || { echo "Renderer resource fragment is missing $font"; exit 1; }
+done
 for f in giac:giac-native gluegen:gluegen-native jogl:jogl-native; do n=${f%%:*}; d=${f#*:}; mkdir -p "$T/$n"
   "$JAVAC" -encoding UTF-8 --release 21 -d "$T/$n" $(find "$ROOT/host/$d/src" -name '*.java')
   "$JAR" cfm "$OUT/org.geogebra.plus.$n.native_0.1.0.jar" "$ROOT/host/$d/META-INF/MANIFEST.MF" -C "$T/$n" .; done
@@ -57,9 +75,11 @@ BI="$IMAGE/configuration/org.eclipse.equinox.simpleconfigurator/bundles.info"
   for j in "$IMAGE"/platform/*.jar; do b=$(bsn "$j"); [ "$b" = org.eclipse.equinox.simpleconfigurator ] && continue
     a=true; frag "$j" && a=false; l=4; [ "$b" = org.eclipse.equinox.common ] && l=2
     echo "$b,$(ver "$j"),platform/$(basename "$j"),$l,$a"; done
-  for n in host:true desktop.resources:false giac.native:false gluegen.native:false jogl.native:false compute.api:false compute.runtime:false engine.pari:true engine.maxima:true engine.gnuplot:true; do
+  for n in host:true desktop.resources:false renderer.resources:false giac.native:false gluegen.native:false jogl.native:false compute.api:false compute.runtime:false engine.pari:true engine.maxima:true engine.gnuplot:true; do
     j="$OUT/org.geogebra.plus.${n%%:*}_0.1.0.jar"; echo "$(bsn "$j"),$(ver "$j"),host/build/$(basename "$j"),4,${n#*:}"; done
 } > "$BI"
+grep -Fqx "org.geogebra.plus.renderer.resources,0.1.0,host/build/$(basename "$RENDERER_RESOURCES"),4,false" "$BI" \
+  || { echo "Renderer resource fragment missing from bundles.info"; exit 1; }
 SC="$(ls "$IMAGE"/platform/org.eclipse.equinox.simpleconfigurator_*.jar)"
 cat > "$IMAGE/configuration/config.ini" <<INI
 # Generated by build.sh (Linux). Installed paths are absolute.
diff --git a/03-RCP-Spike/host/renderer-resources/META-INF/MANIFEST.MF b/03-RCP-Spike/host/renderer-resources/META-INF/MANIFEST.MF
new file mode 100644
index 0000000..4562798
