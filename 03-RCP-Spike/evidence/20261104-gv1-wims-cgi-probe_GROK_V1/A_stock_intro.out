<fieldset class="wims_search_engine" id="searchform">
  <legend><label for="search_keywords">Search Engine</label></legend>

<form action="http://127.0.0.1/wims/wims.cgi#searchform" method="post"  >
<div class='wims_form'><input type="hidden" name="session" value="ZZ8069DD1D.1">
<input type="hidden" name="lang" value="en">
<input type="hidden" name="cmd" value="new">
    <input type="hidden" name="module" value="home">


<a href="http://127.0.0.1/wims/wims.cgi?session=ZZ8069DD1D.1&+lang=en&+module=adm%2Flight&+phtml=search_engine.phtml.en"   class="wims_button_help float_right" role="button" >Tips for searching</a>
    <div class="field search_field">
      <input size="25"
             type="search"
             name="search_keywords"
             value=""
             class="wims_home_form multicomplete"
             placeholder="Enter keywords"
             results="5"
             autosave="search_keywords"
             id="search_keywords"><button class="wims_button icon_button"
                       type="submit"><span class="Searching">Search</span></button>
      <span style="margin-left:2em;display:inline-block;">
<a href="http://127.0.0.1/wims/wims.cgi?session=ZZ8069DD1D.1&+lang=en&+module=adm%2Fbrowse"   class="text_icon browse" >Other browsing methods</a>      </span>
    </div>


      <script>
        jQuery(function($){
          // Get in sessionStorage if affined_search was previously uncollapsed
          var affined_search_state = sessionStorage.getItem("affined_search_state");
          affined_search_state = !affined_search_state ? false : Number(affined_search_state);
          // Display all affined search fields in a collapsible way
          $("#affined_search").accordion({
            collapsible: true,
            active: affined_search_state,
            heightStyle: "content",
            activate : function( event, ui ) {
                affined_search_state = $("#affined_search").accordion("option", "active");
                sessionStorage.setItem("affined_search_state", affined_search_state);
            }
          });
        } );
      </script>

    <fieldset id="affined_search">
      <legend>Filters</legend>
      <div>
        <div class="field box halfwidth float_left">
          <label for="search_category">Category</label>
<select   name="search_category" id="search_category">
<option value="A">WIMS activities</option>
<option value="D">Lessons and references</option>
<option value="T">Online calculators</option>
<option value="X">Interactive exercises</option>
<option value="R">Mathematical recreations</option>
<option value="P">Quick popup tools</option>
<option value="O">Classified exercises (OEF)</option>
<option value="S">Sheets of exercises</option>
<option value="G">Glossary</option>
<option value="C">Open classes</option>
</select>        </div>
        <div class="field box halfwidth float_left">
          <label for="search_and">Method</label>
<select   name="search_and" id="search_and">
<option value="yes">all word groups</option>
<option value="no" selected="selected">one of the word groups</option>
</select>        </div>
        <div class="field box fullwidth">
          <label for="search_lang">Language</label>
<select   name="search_lang" id="search_lang">
<option value="en" selected="selected">English (en)</option>
<option value="fr">Franþais (fr)</option>
<option value="es">Espa±ol (es)</option>
<option value="it">Italiano (it)</option>
<option value="nl">Nederlands (nl)</option>
<option value="ca">CatalÓ (ca)</option>
<option value="si">Slovincina (si)</option>
<option value="de">Deutsch (de)</option>
<option value="cn">Chinese gb (cn)</option>
</select>        </div>

        <div class="field box fullwidth">
          <strong>Level</strong>

<input type="hidden" id="search_level_from" name="search_level_from" value="1">
<input type="hidden" id="search_level_to" name="search_level_to" value="19">
<div class="slider" id="slider_level" style="margin-right:auto;margin-left:auto"></div>

<script src="scripts/js/external/jquery-ui-slider-pips/jquery-ui-slider-pips.min.js"></script>
<link rel="stylesheet" href="scripts/js/external/jquery-ui-slider-pips/jquery-ui-slider-pips.min.css">
<link rel="stylesheet" href="themes/_css/jquery-ui-slider-pips.custom.css">
<style>
  #slider_level .ui-slider-range {background: #676767;}
  .ui-slider-pips .ui-slider-pip-selected-1, .ui-slider-pips .ui-slider-pip-selected-2
    {color: #676767;}
</style>
<script>
/*<![CDATA[*/ jQuery(function(jq){
  var niveaux = new Array(19);
  niveaux[0]='Kinder garten';
  niveaux[1]='Primary School&rarr;';
  niveaux[4]='Primary School&rarr;';
  niveaux[7]='Middle School&rarr;';
  niveaux[10]='High School&rarr;';
  niveaux[13]='University&rarr;';
  niveaux[16]='Graduate';
  jq('#slider_level')
    .slider({min: 1,
             max: niveaux.length-1,
             range: true,
             values: [ jq( "#search_level_from" ).val(), jq( "#search_level_to" ).val() ],
             slide: function( event, ui ) {
        jq( "#search_level_from" ).val(ui.values[0]);
        jq( "#search_level_to" ).val(ui.values[1]);
      }
    })
    .slider('pips',
           {rest: "label",
           labels: niveaux});
  });/*]]>*/
</script>

        </div>
      </div>
    </fieldset>

